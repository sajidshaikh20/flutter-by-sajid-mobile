{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Flutter: Default",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "toolArgs": [
        "--flavor",
        "stage",
        "--dart-define-from-file=stage_env.json"
      ]
    },
    {
      "name": "Flutter: Stage",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "toolArgs": [
        "--flavor", "stage",
        "--dart-define-from-file=stage_env.json"
      ]
    },
    {
      "name": "Flutter: Prod",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "toolArgs": [
        "--flavor", "prod",
        "--dart-define-from-file=prod_env.json"
      ]
    },
    {
      "name": "Flutter: Web (Stage)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "deviceId": "chrome",
      "toolArgs": [
        "--dart-define-from-file=stage_env.json",
        "--web-port=8080"
      ]
    },
    {
      "name": "Flutter: iOS Simulator (Stage)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "toolArgs": [
        "--flavor", "stage",
        "--dart-define-from-file=stage_env.json"
      ]
    }
  ]
}
