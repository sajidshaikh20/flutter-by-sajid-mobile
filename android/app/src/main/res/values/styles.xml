<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Theme applied while the app is starting (Splash screen) -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <!-- Show a splash background -->
        <item name="android:windowBackground">@drawable/launch_background</item>
        <!-- Remove translucency -->
        <item name="android:windowIsTranslucent">false</item>
        <!-- Optional: If you want a logo in splash, replace with your drawable -->
        <!-- Animation duration (optional) -->
        <item name="android:windowSplashScreenAnimationDuration">200</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
    <!-- Theme applied once Flutter draws its first frame -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
